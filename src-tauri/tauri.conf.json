{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft Daily Maps",
  "version": "0.4.0",
  "identifier": "dev.mcdailymaps.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Minecraft Daily Maps",
        "width": 1080,
        "height": 780,
        "minWidth": 760,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
