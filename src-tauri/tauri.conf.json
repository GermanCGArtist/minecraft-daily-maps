{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft Daily Maps",
  "version": "0.1.0",
  "identifier": "dev.minecraftdailymaps.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Minecraft Daily Maps",
        "width": 1180,
        "height": 780,
        "minWidth": 920,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Daily Minecraft world maps",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
